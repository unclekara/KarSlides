{
  "Output": {
    "Width": 1920,
    "Height": 1080,
    "Fps": "50",
    "Send": "async",
    "HoldReleaseMs": 200,
    "Source": "capture"
  },
  "Slots": {
    "Count": 1,
    "NdiNameTemplate": "KarSlides - Slot {n}",
    "Monitors": [ "virtual" ],
    "MonitorWaitSeconds": 30
  },
  "Control": {
    "Port": 9180,
    "Bind": "0.0.0.0",
    "Token": null
  },
  "Vmix": {
    "Enabled": true,
    "Host": "auto",
    "TcpPort": 8099,
    "HttpPort": 0,
    "InputRefreshSeconds": 5
  },
  "Clicker": {
    "Enabled": true,
    "Next": [ "PageDown" ],
    "Prev": [ "PageUp" ],
    "Black": [],
    "Swallow": [ "PageDown", "PageUp" ]
  },
  "Audio": {
    "Enabled": true,
    "BufferMs": 20,
    "OutputDevice": ""
  },
  "Paths": {
    "Inbox": "C:\\KarSlides\\inbox",
    "Cache": "%LOCALAPPDATA%\\KarSlides\\cache"
  },
  "Preflight": {
    "Thumbnails": true
  },
  "Watchdog": {
    "Enabled": true,
    "ComTimeoutMs": 3000,
    "HeartbeatMs": 1000,
    "HeartbeatTimeoutMs": 1000,
    "MissedLimit": 3,
    "RestartPausedShow": false,
    "PausedRestartIntervalMs": 30000
  },
  "Show": {
    "Focus": "both",
    "Topmost": true
  },
  "Preview": {
    "Live": true,
    "Fps": 25,
    "Width": 960,
    "Quality": 75
  },
  "Logging": {
    "Level": "Information",
    "RetainedDays": 14
  }
}
